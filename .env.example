# Discord bot token (required)
DISCORD_TOKEN=

# xAI (Grok) API key
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# OpenAI API key (optional, used for fallback/voice features)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Bot behavior
MAX_TOKENS=5000
WORKER_COUNT=5
BOT_OWNER_ID=248083498433380352
API_TIMEOUT=60

# Data storage overrides (optional, defaults to project root locally)
DATA_DIR=
LOG_DIR=
USER_PREF_DIR=
